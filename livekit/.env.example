# IP of the Linux Docker host reachable by all clients.
# For a physical Android device on Wi-Fi, use the host LAN IP instead.
LIVEKIT_NODE_IP=127.0.0.1

# Example credentials only. Replace both before running a copied configuration.
LIVEKIT_API_KEY=replace_with_your_api_key
LIVEKIT_API_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# For your backend/agent on the same host; Compose does not consume this value.
LIVEKIT_URL=ws://127.0.0.1:7880
